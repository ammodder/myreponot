# AREENAX release signing — TEMPLATE (Task 7-b)
#
# Copy this file to `keystore.properties` in the PROJECT ROOT and fill it in:
#
#     cp keystore.properties.example keystore.properties
#
# `keystore.properties` is git-ignored (.gitignore) and is read by
# app/build.gradle.kts to wire the `release` signing config. Without it,
# `./gradlew assembleRelease` still succeeds but produces an UNSIGNED APK.
# NEVER commit the real file or the keystore itself (also git-ignored:
# *.jks, *.keystore). Generate the keystore with the keytool command in
# SECURITY-BUILD.md (project root), then reference it below.
#
# storeFile — absolute path, or a path relative to the PROJECT ROOT:
#     storeFile=/home/owner/keys/areenax-release.jks
#     storeFile=areenax-release.jks        (→ <project-root>/areenax-release.jks)
storeFile=areenax-release.jks
storePassword=REPLACE_WITH_STORE_PASSWORD
keyAlias=areenax
keyPassword=REPLACE_WITH_KEY_PASSWORD
