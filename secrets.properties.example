# AREENAX owner credentials — build-time vault source (Task 7-a).
#
# 1. Copy this file to `secrets.properties` at the PROJECT ROOT (next to
#    settings.gradle.kts) — the app module (`app/secrets.properties`) works too.
# 2. Fill in the values you want baked into the APK. Leave a key out (or
#    empty) to ship without it — the app then falls back to the in-app
#    "Connect to AREENAX" setup screen (Option 2 in SETUP-BACKEND.md).
# 3. `secrets.properties` is GIT-IGNORED — never commit it, never share it.
#
# WHAT HAPPENS AT BUILD TIME: every :generateVaultKeys run (each build) XOR's
# each value with its own fresh random pad, splits both into 2–4 int-array
# chunks and writes build/generated/vaultKeys/…/GeneratedVaultKeys.kt. No
# plaintext secret ever appears in source, strings.xml, resources, smali or
# BuildConfig. Runtime re-assembly: core/security/SecretVault.kt.
# Full guide: SETUP-BACKEND.md. Values format: raw, no quotes, no escapes.

# Supabase Project URL — Dashboard → Project Settings → API → Project URL
# e.g. https://abcdefgh.supabase.co
supabase.url=

# Supabase anon PUBLIC key — Dashboard → Project Settings → API →
# "anon public" (safe to ship by design; SQL scope in sql/app-config.sql
# lets it read ONLY the app_config row)
supabase.anon_key=

# OPTIONAL — direct API base (SETUP-BACKEND.md Option 3). Non-empty → used
# directly as the API base and Supabase discovery is skipped entirely.
# Accepts https://host, https://host/ or https://host/api.
default.api.url=
